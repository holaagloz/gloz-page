{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "carousel-qa": {
      "projectType": "application", "root": "", "sourceRoot": "tests/harness",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "tests/harness/main.ts", "index": "tests/harness/index.html",
            "outputPath": "dist/carousel-qa", "tsConfig": "tsconfig.qa.json",
            "styles": ["src/styles.scss"],
            "assets": [
              { "glob": "fixture.svg", "input": "tests/harness" },
              { "glob": "**/*", "input": "public/fonts", "output": "fonts" }
            ]
          }
        }
      }
    },
    "gloz": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "gloz",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "outputMode": "static",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": ["src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "350kB", "maximumError": "450kB" },
                { "type": "anyComponentStyle", "maximumWarning": "12kB", "maximumError": "16kB" }
              ],
              "outputHashing": "all"
            },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "gloz:build:production" },
            "development": { "buildTarget": "gloz:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": { "analytics": false }
}
